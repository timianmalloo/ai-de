<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A console app that opens a WPF window: stdout IS the result, in both the host and the probe. -->
    <OutputType>Exe</OutputType>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Q14 only: the REAL ComposerSurface measured in an Auto Grid row, no browser started
         (the TheWriterKeepsItsRoomTests idiom). The host/probe legs are pure WPF. -->
    <ProjectReference Include="..\..\src\AiDe.App\AiDe.App.csproj" />
  </ItemGroup>

</Project>
