<Project Sdk="Microsoft.NET.Sdk">

  <!--
    E-1 (ADR-0043 §7): the CodeMirror 6 notebook qualification spike. A real WPF window hosting the
    real WebView2 control, driven by real Windows input (SendInput, a Windows IME, the Windows
    clipboard) and read back through System.Windows.Automation. The exit code is the verdict:
    0 = every selected check passed, 1 = at least one failed, 2 = the harness could not run.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The console output IS the result, so keep a console attached to a WinExe. -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="page\notebook.html" Link="page\notebook.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="page\notebook.bundle.mjs" Link="page\notebook.bundle.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
