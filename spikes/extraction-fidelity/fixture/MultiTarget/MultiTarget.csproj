<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A multi-targeted project. Option B reads ONE glob and ONE framework, so this is the shape most
    likely to expose the gap: the same sources compile twice against different reference sets, and
    conditional compilation means the two results are not even the same code.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <DefineConstants>$(DefineConstants);FEATURE_ALPHA</DefineConstants>
  </PropertyGroup>

</Project>
