<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A GUI-SUBSYSTEM host, which is the entire point of this project existing.

    DC-014 established that ConPTY does not attach a child when the host's stdio is redirected, and
    its control gives the probe a console of its own with CREATE_NEW_CONSOLE. That left the
    product's OWN configuration unmeasured: AiDe.App is WinExe and therefore has no console at all,
    which is not the same condition as "console-less test host", and not one FreeConsole()
    reproduces faithfully.

    OutputType=WinExe is the configuration under test. Do not change it to Exe.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>false</UseWPF>

    <!--
      A HELPER, not a test project. TerminalGuiHostTests launches it and reads its exit code; it has
      no test framework and produces no .trx, so verify-test-run.py must not expect one — an
      unexplained "NO RESULTS" row trains people to ignore the gate, which is worse than the silence
      it exists to prevent.
    -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AiDe.Core\AiDe.Core.csproj" />
  </ItemGroup>

</Project>
