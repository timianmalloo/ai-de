<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Captured agent output, used as a fixture. Copied rather than embedded so it stays readable in
      the repository: it is evidence a human has to be able to inspect, not just bytes a test loads.
    -->
    <None Include="fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AiDe.Core\AiDe.Core.csproj" />

    <!--
      A BUILD-ORDER dependency, not an assembly reference. The ConPTY conformance case launches this
      executable with CREATE_NEW_CONSOLE (DC-014), so it must exist whenever these tests run — and
      `verify-test-run.py` deliberately runs `dotnet test` PER PROJECT to get per-assembly counts,
      which would otherwise never build it.

      ReferenceOutputAssembly="false" because the tests start it as a process and must not link it.
    -->
    <ProjectReference Include="..\AiDe.Core.TerminalHost\AiDe.Core.TerminalHost.csproj"
                      ReferenceOutputAssembly="false" />

    <!--
      The daemon, built alongside the tests so DaemonProcessTests cannot silently skip.

      Those tests start it as a real second process — the only way to prove the process split at
      all. Without this reference it is simply absent on a clean clone, and the case fails on a
      missing file, which reads as broken tooling rather than as the question going unasked (DC-012).

      ReferenceOutputAssembly="false" because it is started, never linked, and
      SkipGetTargetFrameworkProperties because the daemon targets net10.0-windows while these
      tests target net10.0 — without it the build refuses a reference it is only using for
      ordering.
    -->
    <ProjectReference Include="..\..\src\AiDe.Daemon\AiDe.Daemon.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared by both test projects: every method added to IWorkspaceQueries used to break four
         hand-written stubs across two assemblies. Linked rather than packaged, because a project
         for forty lines is more machinery than the churn it removes. -->
    <Compile Include="..\Shared\FakeWorkspaceQueries.cs" Link="FakeWorkspaceQueries.cs" />
  </ItemGroup>

</Project>
