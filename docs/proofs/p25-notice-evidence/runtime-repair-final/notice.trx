    <UnitTestResult executionId="00f3e1e6-3fab-455a-9f5f-6522fc2270b2" testId="5e19db5b-2850-825d-edff-bb50da7ee504" testName="AiDe.Core.Tests.Watcher.SqliteWatcherObservationStoreTests.RecordSession_RoundTrips_IncludingNullHarnessAndModel" computerName="TIMMALLSTRIX" duration="00:00:00.0103971" startTime="2026-09-17T08:28:17.4301515-07:00" endTime="2026-09-17T08:28:17.4405557-07:00" testType="13cdc9d9-ddb5-4fa4-a97d-d965ccfc6d4b" outcome="Passed" testListId="8c84fa94-04c1-424b-9868-57a2d4851a1d" relativeResultsDirectory="00f3e1e6-3fab-455a-9f5f-6522fc2270b2" />
