    <UnitTestResult executionId="7575b991-ea4e-4efe-80cf-80ed79603d91" testId="3e3a9083-29f6-5825-02e8-a12788af4ba5" testName="AiDe.Core.Tests.Watcher.RegistrationAdmissionTests.NativeRows_RemovedRequiredColumnConstraints_SameNullAssertionFails(table: &quot;registration_notice_delivery&quot;, column: &quot;decision_digest&quot;)" computerName="TIMMALLSTRIX" duration="00:00:00.1073964" startTime="2026-09-17T08:28:12.9467902-07:00" endTime="2026-09-17T08:28:13.0541377-07:00" testType="13cdc9d9-ddb5-4fa4-a97d-d965ccfc6d4b" outcome="Passed" testListId="8c84fa94-04c1-424b-9868-57a2d4851a1d" relativeResultsDirectory="7575b991-ea4e-4efe-80cf-80ed79603d91">
      <Output>
        <StdOut>MUTANT registration_notice_delivery.decision_digest required-column constraints:
CREATE TABLE native_registration_admission_fact (&#xD;
    operation_id TEXT NOT NULL PRIMARY KEY&#xD;
        CHECK(typeof(operation_id)='text' AND length(operation_id) BETWEEN 1 AND 128&#xD;
            AND instr(operation_id,char(0))=0),&#xD;
    schema_version INTEGER NOT NULL CHECK(typeof(schema_version)='integer' AND schema_version=1),&#xD;
