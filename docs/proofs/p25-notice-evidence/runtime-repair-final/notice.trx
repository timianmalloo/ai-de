NTEGER\u0022,\u0022value\u0022:0},{\u0022column\u0022:\u0022due_utc\u0022,\u0022type\u0022:\u0022INTEGER\u0022,\u0022value\u0022:0},{\u0022column\u0022:\u0022requested_parent_message_id\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:null},{\u0022column\u0022:\u0022original_id\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022original-session\u0022},{\u0022column\u0022:\u0022first_receipt_n\u0022,\u0022type\u0022:\u0022INTEGER\u0022,\u0022value\u0022:7},{\u0022column\u0022:\u0022first_kind\u0022,\u0022type\u0022:\u0022INTEGER\u0022,\u0022value\u0022:1},{\u0022column\u0022:\u0022current_receipt_n\u0022,\u0022type\u0022:\u0022INTEGER\u0022,\u0022value\u0022:7},{\u0022column\u0022:\u0022application_state\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022applied\u0022}]"],"coord_projection_feed":["[{\u0022column\u0022:\u0022n\u0022,\u0022type\u0022:\u0022INTEGER\u0022,\u0022value\u0022:7},{\u0022column\u0022:\u0022scope\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022synthetic-scope\u0022},{\u0022column\u0022:\u0022epoch\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022epoch-1\u0022},{\u0022column\u0022:\u0022event_key\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022original-event\u0022},{\u0022column\u0022:\u0022is_initial\u0022,\u0022type\u0022:\u0022INTEGER\u0022,\u0022value\u0022:1},{\u0022column\u0022:\u0022admission_n\u0022,\u0022type\u0022:\u0022INTEGER\u0022,\u0022value\u0022:null},{\u0022column\u0022:\u0022outcome\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022applied\u0022},{\u0022column\u0022:\u0022application_state\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022applied\u0022},{\u0022column\u0022:\u0022recovery_status\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022none\u0022},{\u0022column\u0022:\u0022eligibility_generation\u0022,\u0022type\u0022:\u0022INTEGER\u0022,\u0022value\u0022:0},{\u0022column\u0022:\u0022payload_presence\u0022,\u0022type\u0022:\u0022INTEGER\u0022,\u0022value\u0022:1},{\u0022column\u0022:\u0022reason\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:null},{\u0022column\u0022:\u0022session_id\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022original-session\u0022},{\u0022column\u0022:\u0022session_generation\u0022,\u0022type\u0022:\u0022INTEGER\u0022,\u0022value\u0022:2147483648},{\u0022column\u0022:\u0022message_id\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022original-message\u0022},{\u0022column\u0022:\u0022parent_event_key\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:null},{\u0022column\u0022:\u0022parent_application_state\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022applied\u0022},{\u0022column\u0022:\u0022source_offset\u0022,\u0022type\u0022:\u0022INTEGER\u0022,\u0022value\u0022:null},{\u0022column\u0022:\u0022source_end\u0022,\u0022type\u0022:\u0022INTEGER\u0022,\u0022value\u0022:null},{\u0022column\u0022:\u0022raw_digest\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:null}]"],"daydream_event_fact":[],"daydream_observation_fact":[],"declared_artifact_fact":[],"observed_span_fact":["[{\u0022column\u0022:\u0022span_id\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022original-span\u0022},{\u0022column\u0022:\u0022session_id\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022original-session\u0022},{\u0022column\u0022:\u0022trace_id\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022original-trace\u0022},{\u0022column\u0022:\u0022source_span_id\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022original-source\u0022},{\u0022column\u0022:\u0022operation_name\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022test\u0022},{\u0022column\u0022:\u0022recorded_at\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u00222026-01-01\u0022}]"],"registration_notice_delivery":["[{\u0022column\u0022:\u0022sentinel\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022preserve\u0022}]"],"score_dimension_cell":[],"score_dispute_fact":[],"score_tripped_floor_cell":[],"scored_episode_cell":[],"session_ended":["[{\u0022column\u0022:\u0022session_id\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022original-session\u0022}]"],"session_heartbeat":["[{\u0022column\u0022:\u0022session_id\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022original-session\u0022},{\u0022column\u0022:\u0022monotonic_ticks\u0022,\u0022type\u0022:\u0022INTEGER\u0022,\u0022value\u0022:42}]"],"sqlite_sequence":["[{\u0022column\u0022:\u0022name\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022coord_projection_feed\u0022},{\u0022column\u0022:\u0022seq\u0022,\u0022type\u0022:\u0022INTEGER\u0022,\u0022value\u0022:7}]"],"watcher_schema_version":["[{\u0022column\u0022:\u0022version\u0022,\u0022type\u0022:\u0022INTEGER\u0022,\u0022value\u0022:8},{\u0022column\u0022:\u0022applied_at\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u00222026-01-01\u0022}]"],"work_episode_dim":["[{\u0022column\u0022:\u0022episode_id\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022original-episode\u0022},{\u0022column\u0022:\u0022session_id\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022original-session\u0022},{\u0022column\u0022:\u0022generation\u0022,\u0022type\u0022:\u0022INTEGER\u0022,\u0022value\u0022:2147483648},{\u0022column\u0022:\u0022goal\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022goal\u0022},{\u0022column\u0022:\u0022done_when\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022done\u0022},{\u0022column\u0022:\u0022not_in_scope\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u0022excluded\u0022},{\u0022column\u0022:\u0022opened_at\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:\u00222026-01-01\u0022},{\u0022column\u0022:\u0022closed_at\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:null},{\u0022column\u0022:\u0022outcome\u0022,\u0022type\u0022:\u0022TEXT\u0022,\u0022value\u0022:null}]"]}</StdOut>
