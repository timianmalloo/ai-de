<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--  Benchmarks are measured in Release: a Debug-build number would understate the product
          and overstate the problem, and either way it would not be the shipped behaviour.  -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AiDe.Core\AiDe.Core.csproj" />
  </ItemGroup>

</Project>
