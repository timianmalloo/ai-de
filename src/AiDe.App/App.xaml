<Application x:Class="AiDe.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AiDe.App"
             xmlns:avalonDock="clr-namespace:AvalonDock.Controls;assembly=AvalonDock">
    <!--
        StartupUri is set in App.xaml.cs, not here. WPF applies it AFTER OnStartup returns, and it
        refuses null, so a declared StartupUri cannot be withdrawn by the headless conductor path —
        the shell would show a window, attach a workspace and start a terminal on a run whose whole
        claim is that it hosts none. Assigning it on the interactive path is the same behaviour with
        one branch that can decline it.
    -->
    <Application.Resources>
        <!--  Semantic brushes mirroring DESIGN.md. Components reference these, never raw values,
              so a token change is one edit and the craft gate can enforce it outward.  -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#12151A" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1A1F26" />
        <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#0D1014" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2A313B" />
        <SolidColorBrush x:Key="TextBrush" Color="#E4E9EF" />

        <!--
            THE REST OF THE PALETTE, DECLARED HERE RATHER THAN TWO HUNDRED LINES DOWN. A
            StaticResource resolves against what has already been parsed, so a brush declared after
            the styles that use it cannot be referenced by them. These seven sat below the menu
            templates, which is why the implicit default styles at the bottom of this file could not
            have been written where they belong. Tokens first, templates second, styles last.
        -->
        <SolidColorBrush x:Key="TextMutedBrush" Color="#98A3B2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5B9DD9" />
        <SolidColorBrush x:Key="VerifiedBrush" Color="#5FB98F" />
        <SolidColorBrush x:Key="InferredBrush" Color="#D8A650" />
        <SolidColorBrush x:Key="UnverifiedBrush" Color="#98A3B2" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E07A6F" />
        <SolidColorBrush x:Key="FocusBrush" Color="#8FC0EA" />

        <!--
            DISABLED IS A STATE, NOT AN OPACITY (DESIGN.md, "Disabled is a state").
            TextMuted composited at 50% over the sunken ground measures 2.73:1 — below the 3:1 floor
            for a meaningful graphic — so `Opacity 0.5` made "unavailable" and "unreadable" the same
            rendering. This value was already in this file three times, as a raw literal on the
            disabled MenuItem foreground; it is now the token those three reference. ContrastFloor
            computes it against all three grounds rather than this comment asserting a number (TC6).
        -->
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#7C8896" />

        <!--
            MENU COLOURS. Reported as illegible: the Menu carried a dark background and a light
            foreground, but a MenuItem's DROPDOWN uses the system popup template, which is light —
            so light text landed on a light background. Both surfaces are stated explicitly rather
            than one being left to inherit, because inheriting is what produced the mismatch.
        -->
        <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#161A20" />
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#243040" />
        <SolidColorBrush x:Key="MenuBorderBrush" Color="#2B333D" />

        <!--
            ICON SYSTEM. Lucide-style stroke geometries (MIT idiom) as WPF path data, so the app
            ships no image assets and every icon inherits the palette (rendered as a stroked Path,
            Stroke = the control's Foreground). Keyed by role so the activity rail, tabs and menus
            draw from one set. Defined here, before the templates that reference them, so the
            StaticResource lookups resolve. Extend here; never inline a glyph character.
        -->
        <Geometry x:Key="IconExplore">M3 6.5a1.5 1.5 0 0 1 1.5-1.5h3.5l1.5 1.5h7a1.5 1.5 0 0 1 1.5 1.5v7a1.5 1.5 0 0 1-1.5 1.5h-13a1.5 1.5 0 0 1-1.5-1.5z</Geometry>
        <Geometry x:Key="IconGraph">M6 4a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM18 6a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM9 16a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM8 7l8 1.5M8 16l1-6.5</Geometry>
        <Geometry x:Key="IconCoordinate">M6 4a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6zM17 15a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6zM6 7.6v4.4a3 3 0 0 0 3 3h6</Geometry>
        <Geometry x:Key="IconCompose">M4 20h4l9.5-9.5a2 2 0 0 0-3-3L5 16.5zM14 6.5l3 3</Geometry>
        <Geometry x:Key="IconAudit">M4.5 12a7.5 7.5 0 1 0 2.7-5.8M4 4v4h4M12 8.5v4l3 1.8</Geometry>
        <Geometry x:Key="IconFolderOpen">M3 7h6l2 2h10v9a2 2 0 0 1-2 2H3z</Geometry>
        <Geometry x:Key="IconTerminal">M3 5a1.5 1.5 0 0 1 1.5-1.5h15A1.5 1.5 0 0 1 21 5v14a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 19zM7 9l3 3-3 3M13 15h4</Geometry>
        <Geometry x:Key="IconSend">M22 2 11 13M22 2l-7 20-4-9-9-4z</Geometry>
        <Geometry x:Key="IconClose">M7 7l10 10M17 7 7 17</Geometry>
        <Geometry x:Key="IconSearch">M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM16 16l4.5 4.5</Geometry>
        <Geometry x:Key="IconLayout">M3.5 4.5h17v15h-17zM3.5 10h17M10 10v9.5</Geometry>
        <Geometry x:Key="IconRefresh">M4 12a8 8 0 0 1 13.7-5.7L21 9M21 4v5h-5M20 12a8 8 0 0 1-13.7 5.7L3 15M3 20v-5h5</Geometry>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource MenuBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource MenuBorderBrush}" />
        </Style>

        <!--
            MENU TEMPLATES. The default WPF MenuItem/ContextMenu popups keep the system chrome —
            a thick square border and a heavy shadow — which read as clunky against the soft
            facelift. These retemplate the four MenuItem roles and the ContextMenu so every dropdown
            is a THIN (1px), ROUNDED (8px) surface that floats on a subtle shadow. A menu Popup is a
            composited window of its own, so a DropShadow here is airspace-safe (unlike over a pane).
        -->
        <ControlTemplate x:Key="MenuItemTopLevelItem" TargetType="{x:Type MenuItem}">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="MenuItemTopLevelHeader" TargetType="{x:Type MenuItem}">
            <Grid>
                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                </Border>
                <Popup x:Name="Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="{StaticResource MenuBackgroundBrush}" BorderBrush="{StaticResource MenuBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="0,4" SnapsToDevicePixels="True">
                        <ItemsPresenter Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHoverBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="MenuItemSubmenuItem" TargetType="{x:Type MenuItem}">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                    Margin="4,1" Padding="9,5" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIcon" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Gesture" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter ContentSource="Icon" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="28,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="MenuItemSubmenuHeader" TargetType="{x:Type MenuItem}">
            <Grid>
                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                        Margin="4,1" Padding="9,5" SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                        <Path Grid.Column="1" Data="M0,0 L4,4 L0,8 Z" Fill="{DynamicResource TextMutedBrush}"
                              Margin="20,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Popup x:Name="Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" HorizontalOffset="-4"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="{StaticResource MenuBackgroundBrush}" BorderBrush="{StaticResource MenuBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="0,4" SnapsToDevicePixels="True">
                        <ItemsPresenter Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="{StaticResource MenuBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Template" Value="{StaticResource MenuItemSubmenuItem}" />
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource MenuItemTopLevelHeader}" />
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource MenuItemTopLevelItem}" />
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource MenuItemSubmenuHeader}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            The right-click / context dropdown surface: a thin, rounded, floating card, matching the
            top-level menu popups so every dropdown in the app reads the same.
        -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource MenuBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{StaticResource MenuBackgroundBrush}" BorderBrush="{StaticResource MenuBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="0,4" SnapsToDevicePixels="True">
                            <ItemsPresenter Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            The vertical strips down the sides of the docking host are AvalonDock's AUTO-HIDE
            anchors. This product never creates a LayoutAnchorable, so they can never contain
            anything — they were decoration that looked like controls, which is worse than absent.
        -->
        <Style TargetType="{x:Type avalonDock:LayoutAnchorSideControl}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <!--
            FACELIFT — soft islands. Radii are TOKENS: a control rounds by referencing these, never a
            literal, so the craft gate can enforce it and one edit resizes them all. Elevation is
            reserved for COMPOSITED chrome (the command-palette overlay, dialogs) and is NEVER applied
            over an HwndHost/WebView2 pane, where WPF effects do not composite (the airspace rule the
            wpf-styling-expert holds a veto on). Panes soften with radius + border, not shadow.
        -->
        <CornerRadius x:Key="RadiusSm">4</CornerRadius>
        <CornerRadius x:Key="RadiusMd">6</CornerRadius>
        <CornerRadius x:Key="RadiusLg">10</CornerRadius>
        <CornerRadius x:Key="RadiusIsland">12</CornerRadius>
        <DropShadowEffect x:Key="ElevationRaised" BlurRadius="16" ShadowDepth="0" Opacity="0.34" Color="#000000" />

        <!--
            THE ONE BUTTON CHROME. Shared by the keyed RoundedButton, the implicit Button default and
            the implicit ToggleButton default, so a button added tomorrow looks like the app without
            anyone having to remember a style name.

            THE FOCUS RING IS ITS OWN OUTLINE (AR4, WCAG 2.4.7). It used to be a trigger that
            recoloured Chrome's BorderBrush - and every rail button sets BorderThickness="0", so the
            ring had zero width and rendered NOTHING while a comment two lines up claimed it did.
            FocusRing is a second border with its own 2px thickness that no caller can zero, drawn
            just outside the chrome and never hit-testable.

            DISABLED IS A TOKEN PAIRING, NOT AN OPACITY (A4). Opacity 0.5 over the sunken rail
            measured 2.73:1 against a 3:1 floor. Both the content's foreground and the templated
            parent's are set, because a rail glyph strokes itself from the BUTTON's Foreground while
            a caption reads the ContentPresenter's - and the TargetName'd setter is the half a
            caller's local Foreground cannot outrank.
        -->
        <ControlTemplate x:Key="ChromeButtonTemplate" TargetType="ButtonBase">
            <Grid>
                <Border x:Name="Chrome"
                        CornerRadius="{StaticResource RadiusMd}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter x:Name="Content"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
                <Border x:Name="FocusRing"
                        Margin="-1"
                        BorderThickness="2"
                        BorderBrush="Transparent"
                        CornerRadius="{StaticResource RadiusMd}"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MenuHoverBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource DisabledTextBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--  The toggle form: the same chrome plus a checked state, so a two-state control reads as
              chosen rather than as the platform's pale face (measured #BCDDEE on our ground).  -->
        <ControlTemplate x:Key="ChromeToggleTemplate" TargetType="ToggleButton">
            <Grid>
                <Border x:Name="Chrome"
                        CornerRadius="{StaticResource RadiusMd}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter x:Name="Content"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
                <Border x:Name="FocusRing"
                        Margin="-1"
                        BorderThickness="2"
                        BorderBrush="Transparent"
                        CornerRadius="{StaticResource RadiusMd}"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource SurfaceSunkenBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MenuHoverBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource DisabledTextBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--  Kept as a key because the call sites name it, and naming the app's button explicitly is
              not wrong. It is now the same thing the implicit default already gives you.  -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template" Value="{StaticResource ChromeButtonTemplate}" />
        </Style>

        <!--
            ============================================================================
            THEME COVERAGE IS OPT-OUT, NOT OPT-IN (DESIGN.md TC1-TC3)
            ============================================================================

            WHAT WAS WRONG. This shell themed its CONTAINERS and left its LEAVES to WPF, whose
            platform default is a LIGHT theme. Six implicit styles existed and not one was for a text
            or an input control, so eighteen base types fell back to the platform and twenty-eight
            live instantiations rendered near-black ink on a themed dark ground - measured at 1.15:1
            and 1.27:1 against a 4.5:1 floor. Text was not merely low-contrast; it was invisible.

            WHY IMPLICIT RATHER THAN PER-ELEMENT. Per-element brushes make correctness a habit: the
            control that is added tomorrow regresses silently and nothing fails. An implicit
            (TargetType-only) style makes the theme the default and an escape the explicit act, so
            the NEXT control is correct without anyone remembering this file exists.

            INK AND GROUND TOGETHER, ALWAYS (TC2). The previous partial fix themed a ListBoxItem's
            Foreground and left its ListBox's Background on the platform's white - and so converted
            dark-on-dark into light-on-white at 1.22:1. A partial pairing is worse than none, so
            every style below states both. Where the honest ground is "whatever the container
            paints", it is stated as such (x:Null for the inline text types, Transparent for the row
            and tab types) rather than left unsaid: an unstated ground is what nobody measured.

            WHY x:Null AND NOT Transparent FOR TextBlock. Transparent is hit-testable and null is
            not. Painting a transparent ground under every run of text in the app would silently
            change which element receives a press - inside a draggable tab header, that is a
            behaviour change wearing a theming change's clothes.

            MEASURED, NOT ASSERTED (TC6). ContrastFloorTests renders these controls under this
            dictionary and computes every pairing from the resolved brushes; the numbers live there,
            not in this comment.
        -->

        <!--  Inline text. Ink only has a ground when its container gives it one; that is the pairing
              that gets measured, and x:Null says so without changing hit-testing.  -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{x:Null}" />
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{x:Null}" />
        </Style>

        <!--  Text entry is a SUNKEN well: a field the operator types into reads as depth, and the
              read-only compiled view stops being the brightest element on its pane.  -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style TargetType="RichTextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <!--  The app's button, by default. AvalonDock's own chrome is exempted in its own resource
              scope (DockRoundedTabs), which is nearer in the tree and therefore wins.  -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template" Value="{StaticResource ChromeButtonTemplate}" />
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template" Value="{StaticResource ChromeToggleTemplate}" />
        </Style>

        <!--
            THE BULLET IS DRAWN HERE, NOT BY THE PLATFORM. The platform's BulletChrome paints its
            check glyph in a fixed near-black, so a dark ground under it produces a control whose
            CHECKED and UNCHECKED states are indistinguishable - a state that reads as the wrong
            answer, which is worse than an unreadable label. The glyph is ours, in the ink token, so
            it is legible by the same measurement everything else is.
        -->
        <ControlTemplate x:Key="ChromeCheckBoxTemplate" TargetType="CheckBox">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <Border x:Name="Box"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True" />
                    <Path x:Name="Check" Visibility="Collapsed"
                          Data="M3.5,8.5 L6.5,11.5 L12.5,4.5"
                          Stroke="{StaticResource TextBrush}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <Rectangle x:Name="Mixed" Visibility="Collapsed" Width="8" Height="2"
                               Fill="{StaticResource TextBrush}" />
                    <Border x:Name="FocusRing" Margin="-3" BorderThickness="2" BorderBrush="Transparent"
                            CornerRadius="{StaticResource RadiusSm}" IsHitTestVisible="False" />
                </Grid>
                <ContentPresenter x:Name="Content" Grid.Column="1" Margin="8,0,0,0"
                                  VerticalAlignment="Center" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="{x:Null}">
                    <Setter TargetName="Mixed" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource DisabledTextBrush}" />
                    <Setter TargetName="Check" Property="Stroke" Value="{StaticResource DisabledTextBrush}" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DisabledTextBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template" Value="{StaticResource ChromeCheckBoxTemplate}" />
        </Style>

        <!--  The same reasoning as the checkbox: the platform's radio dot is a fixed dark fill.  -->
        <ControlTemplate x:Key="ChromeRadioButtonTemplate" TargetType="RadioButton">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <Ellipse x:Name="Box"
                             Fill="{TemplateBinding Background}"
                             Stroke="{TemplateBinding BorderBrush}"
                             StrokeThickness="1" />
                    <Ellipse x:Name="Dot" Visibility="Collapsed" Width="8" Height="8"
                             Fill="{StaticResource TextBrush}" />
                    <Ellipse x:Name="FocusRing" Margin="-3" Stroke="Transparent" StrokeThickness="2"
                             IsHitTestVisible="False" />
                </Grid>
                <ContentPresenter x:Name="Content" Grid.Column="1" Margin="8,0,0,0"
                                  VerticalAlignment="Center" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Box" Property="Stroke" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Box" Property="Stroke" Value="{StaticResource FocusBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="FocusRing" Property="Stroke" Value="{StaticResource FocusBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource DisabledTextBrush}" />
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DisabledTextBrush}" />
                    <Setter TargetName="Box" Property="Stroke" Value="{StaticResource DisabledTextBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template" Value="{StaticResource ChromeRadioButtonTemplate}" />
        </Style>

        <!--  A dropdown's closed face is themed here; its popup rows are ComboBoxItem, which is the
              SAME pairing trap as ListBox/ListBoxItem and is therefore stated beside it.  -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource MenuBackgroundBrush}" />
        </Style>

        <!--  The list and its rows, as one pairing. This is pair 8's site: the item's ink was themed
              and the list's ground was not, so the command palette rendered #E4E9EF on the
              platform's #FFFFFF at 1.22:1 - the inverse of the defect the fix was for.  -->
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <ControlTemplate x:Key="ChromeListBoxItemTemplate" TargetType="ListBoxItem">
            <Border x:Name="Row"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="{StaticResource RadiusSm}"
                    SnapsToDevicePixels="True">
                <ContentPresenter x:Name="Content" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource MenuHoverBrush}" />
                </Trigger>
                <!--  Selection is the accent ground with the sunken ink on it: a selected row must
                      not be the one row in the app that reverts to the platform's pale highlight.  -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource SurfaceSunkenBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource DisabledTextBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template" Value="{StaticResource ChromeListBoxItemTemplate}" />
        </Style>

        <!--  The tree and its rows. The row's ground is Transparent because the tree paints it and a
              second opaque ground there would hide the selection the template draws.  -->
        <Style TargetType="TreeView">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!--  A tab header sits ON chrome somebody else painted (AvalonDock's, or a TabControl's), so
              Transparent is the true ground and the ink is what was missing.  -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <!--  Every top-level window, not just the one that remembered. A dialog opened with `new
              Window` used to inherit nothing at all.  -->
        <Style TargetType="Window">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        </Style>

        <!--  Terminal palette. The ANSI sixteen are a REQUIRED vocabulary: programs address them by
              index and expect red to read as red, so unlike the semantic tokens above these cannot
              be freely rethemed. What is chosen here is the shade — each one pulled toward the
              design language, and each checked to stay legible on the terminal ground rather than
              adopted from a default palette that assumed a different background.
              The four that have a semantic twin ARE that twin: red is DangerBrush, green is
              VerifiedBrush, yellow is InferredBrush, blue is AccentBrush — so a failing build and a
              failing gate are the same red.  -->
        <Color x:Key="TerminalAnsi0">#1A1F26</Color>
        <Color x:Key="TerminalAnsi1">#E07A6F</Color>
        <Color x:Key="TerminalAnsi2">#5FB98F</Color>
        <Color x:Key="TerminalAnsi3">#D8A650</Color>
        <Color x:Key="TerminalAnsi4">#5B9DD9</Color>
        <Color x:Key="TerminalAnsi5">#B08AD0</Color>
        <Color x:Key="TerminalAnsi6">#5FB2B9</Color>
        <Color x:Key="TerminalAnsi7">#C3CBD6</Color>
        <Color x:Key="TerminalAnsi8">#5A6472</Color>
        <Color x:Key="TerminalAnsi9">#F09A90</Color>
        <Color x:Key="TerminalAnsi10">#84D2AC</Color>
        <Color x:Key="TerminalAnsi11">#EFC275</Color>
        <Color x:Key="TerminalAnsi12">#8FC0EA</Color>
        <Color x:Key="TerminalAnsi13">#CBA9E4</Color>
        <Color x:Key="TerminalAnsi14">#88CDD3</Color>
        <Color x:Key="TerminalAnsi15">#F2F6FA</Color>

        <!--  The terminal's own ground and ink. Sunken rather than Surface: a terminal is a well the
              workspace looks into, and the depth is what separates program output from chrome.  -->
        <Color x:Key="TerminalBackground">#0D1014</Color>
        <Color x:Key="TerminalForeground">#E4E9EF</Color>
        <Color x:Key="TerminalCursor">#5B9DD9</Color>
    </Application.Resources>
</Application>
