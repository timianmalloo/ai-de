  <Setter Property="Control.Template">
    <Setter.Value>
      <ControlTemplate TargetType="avalondock:LayoutDocumentTabItem">
        <avalondock:DropDownControlArea DropDownContextMenu="{x:Null}" DropDownContextMenuDataContext="{x:Null}" Style="{DynamicResource DropDownControlArea}">
