<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" />
    <!--
      ADR-0015: the windowed WebView2 control, kept, with overlaps handled by a snapshot swap. The
      composition control was measured killing the process with a native access violation when its
      pane is floated (spike webview2-airspace).
    -->
    <PackageReference Include="Microsoft.Web.WebView2" />
    <!--
      ADR-0019: native AvalonEdit (MIT) for the read-only code viewer — a pure WPF Control, so no
      HwndHost/WebView2 airspace (unlike Monaco), confirmed by the spikes/avalonedit-viewer PoC.
    -->
    <PackageReference Include="AvalonEdit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiDe.Core\AiDe.Core.csproj" />
  </ItemGroup>

  <!--
    The daemon ships WITH the shell, in a subfolder of its own.

    Beside the shell rather than on PATH because the pair are versioned together: finding "a" daemon
    somewhere else is how a shell ends up talking to a build it was never tested against.

    In its OWN folder rather than merged into the shell's output because the two share assemblies,
    and copying one build's AiDe.Core.dll over another's is a clobber waiting for the first version
    where they differ — which is exactly the mismatch the dual-major handshake exists to survive.

    ReferenceOutputAssembly="false" because the shell launches the daemon and never links it;
    SkipGetTargetFrameworkProperties because the reference is for build ordering only.
  -->
  <ItemGroup>
    <ProjectReference Include="..\AiDe.Daemon\AiDe.Daemon.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Target Name="CopyDaemonBesideShell" AfterTargets="Build">
    <ItemGroup>
      <DaemonPayload Include="$(MSBuildThisFileDirectory)..\AiDe.Daemon\bin\$(Configuration)\net10.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(DaemonPayload)" DestinationFolder="$(OutDir)daemon\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    The same copy again, for PUBLISH. AfterTargets="Build" writes to $(OutDir); publish writes to
    $(PublishDir) and does not carry it across, so the published shell shipped WITHOUT the daemon it
    launches, and no workspace could be opened at all. The only symptom was "This workspace could not
    be opened", which reads like a problem with the workspace. The developer build was correct
    throughout, which is exactly why it survived: the layout that was tested was never the layout
    that shipped.
  -->
  <!--
    The MCP server ships beside the shell for the same reason and in its own folder, and it carries
    the same PUBLISH target — because the daemon's absence from the published layout was invisible in
    every developer build and surfaced only as "this workspace could not be opened". A server the
    published shell cannot find would fail more quietly still: .mcp.json would name a path that does
    not exist, and the agent would simply have no tools and no reason to ask why.
  -->
  <ItemGroup>
    <ProjectReference Include="..\AiDe.Mcp\AiDe.Mcp.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Target Name="CopyMcpBesideShell" AfterTargets="Build">
    <ItemGroup>
      <McpPayload Include="$(MSBuildThisFileDirectory)..\AiDe.Mcp\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(McpPayload)" DestinationFolder="$(OutDir)mcp\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyMcpBesidePublishedShell" AfterTargets="Publish">
    <ItemGroup>
      <PublishedMcpPayload Include="$(MSBuildThisFileDirectory)..\AiDe.Mcp\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishedMcpPayload)" DestinationFolder="$(PublishDir)mcp\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyDaemonBesidePublishedShell" AfterTargets="Publish">
    <ItemGroup>
      <PublishedDaemonPayload Include="$(MSBuildThisFileDirectory)..\AiDe.Daemon\bin\$(Configuration)\net10.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishedDaemonPayload)" DestinationFolder="$(PublishDir)daemon\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="AiDe.App.Tests" />
  </ItemGroup>

</Project>
