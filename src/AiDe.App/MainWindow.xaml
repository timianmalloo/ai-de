<Window x:Class="AiDe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1180"
        Height="720"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
    <!--  Layout:MultiPanelWorkstation — the docking host owns the whole body. Nothing here is a
          fixed region: every pane is resizable, dockable, floatable and collapsible (US-9).  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title strip: workspace identity and the named-layout switcher.  -->
        <Grid Grid.Row="0"
              Background="{StaticResource SurfaceSunkenBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="12,8"
                       FontSize="15"
                       Foreground="{StaticResource TextBrush}"
                       Text="{Binding Heading}" />
            <Button Grid.Column="2"
                    Margin="12,6"
                    Padding="10,3"
                    AutomationProperties.Name="Reset workbench layout"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    Click="OnResetLayout"
                    Content="Reset layout"
                    Foreground="{StaticResource TextBrush}" />
        </Grid>

        <!--  Body: navigation rail plus the docking host.  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Background="{StaticResource SurfaceSunkenBrush}"
                        KeyboardNavigation.TabNavigation="Once">
                <Button Margin="6,8,6,2"
                        Height="32"
                        AutomationProperties.Name="Explore"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Content="◫"
                        Foreground="{StaticResource AccentBrush}"
                        ToolTip="Explore" />
                <Button Margin="6,2"
                        Height="32"
                        AutomationProperties.Name="Coordinate"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="◑"
                        Foreground="{StaticResource TextMutedBrush}"
                        ToolTip="Coordinate" />
                <Button Margin="6,2"
                        Height="32"
                        AutomationProperties.Name="Compose"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="✎"
                        Foreground="{StaticResource TextMutedBrush}"
                        ToolTip="Compose" />
                <Button Margin="6,2"
                        Height="32"
                        AutomationProperties.Name="Audit"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="◷"
                        Foreground="{StaticResource TextMutedBrush}"
                        ToolTip="Audit" />
            </StackPanel>

            <!--  The docking host is injected by the composition root, not declared here: the
                  layout model is the source of truth and the view is its projection.  -->
            <ContentControl x:Name="WorkbenchHost"
                            Grid.Column="1"
                            AutomationProperties.Name="Workbench panes" />
        </Grid>

        <!--  Status strip. The live region lives here: announcements are both spoken to assistive
              technology and visible, so sighted and non-sighted users get the same information.  -->
        <Grid Grid.Row="2"
              Background="{StaticResource SurfaceSunkenBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="LiveRegionHost"
                            Grid.Column="0"
                            Margin="12,6" />
            <TextBlock Grid.Column="1"
                       Margin="12,6"
                       AutomationProperties.Name="Workspace health"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="{Binding StatusMessage}" />
        </Grid>
    </Grid>
</Window>
