<Window x:Class="AiDe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1180"
        Height="720"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
    <!--  RootLayer lets the command palette overlay the workbench without displacing it.  -->
    <Grid x:Name="RootLayer">
    <!--  Layout:MultiPanelWorkstation — the docking host owns the whole body. Nothing here is a
          fixed region: every pane is resizable, dockable, floatable and collapsible (US-9).  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Menu bar. Every item here also has a keyboard chord and a palette entry, and the chord
              is shown beside it — a command reachable only by a chord nobody was told about is a
              command nobody uses, which is what this row exists to fix.  -->
        <Menu Grid.Row="0" x:Name="MainMenu" />

        <!--  Title strip: workspace identity and the named-layout switcher.  -->
        <Grid Grid.Row="1"
              Background="{StaticResource SurfaceSunkenBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="12,8"
                       FontSize="15"
                       Foreground="{StaticResource TextBrush}"
                       Text="{Binding Heading}" />
            <Button Grid.Column="2"
                    Margin="12,6"
                    Padding="10,3"
                    Style="{StaticResource RoundedButton}"
                    AutomationProperties.Name="Reset workbench layout"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    Click="OnResetLayout"
                    Content="Reset layout"
                    Foreground="{StaticResource TextBrush}" />
        </Grid>

        <!--  Body: navigation rail plus the docking host.  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="ActivityRail"
                        Grid.Column="0"
                        Background="{StaticResource SurfaceSunkenBrush}"
                        KeyboardNavigation.TabNavigation="Once"
                        KeyboardNavigation.DirectionalNavigation="Cycle">
                <!--  AR2 — THE ONE PRIMARY ACTION, above the group and separated from it. The rail
                      holds DESTINATIONS (AR1); "new session" is a verb, so it does not join them,
                      and the accent fill is reserved for exactly this (DESIGN.md, icon system).
                      It runs the SAME catalog command as File -> New Session, so there is one door
                      and not a second one that can drift from it (AR5).  -->
                <Button x:Name="NewSessionRailButton" Click="OnNewSessionFromRail"
                        Margin="6,8,6,4" Height="44" Style="{StaticResource RoundedButton}"
                        AutomationProperties.Name="New session"
                        Background="{StaticResource AccentBrush}"
                        BorderThickness="0"
                        Foreground="{StaticResource SurfaceSunkenBrush}"
                        ToolTip="New session &#8212; Ctrl+N">
                    <Path Width="22" Height="22" Stretch="Uniform" Data="{StaticResource IconAdd}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Border Height="1" Margin="12,4,12,6" Background="{StaticResource BorderBrush}" />
                <!--  Roving tab-stop: Tab lands on the rail once; Up/Down arrows move between its
                      buttons (DirectionalNavigation=Cycle), the standard toolbar/activity-bar idiom.  -->
                <!--  Icon-only vertical navigation rail (VS Code / JetBrains idiom): the 56px column
                      cannot hold a legible text label under a 20px glyph, so labels were clipped
                      ("Coordinate" -> "ordina"). Discoverability is carried by the tooltip and the
                      accessibility by AutomationProperties.Name, so no meaning is lost by dropping the
                      caption. Targets are 44x44 (WCAG 2.5.8 comfortable). The active item is an accent
                      glyph on a soft raised pill with NO hard border, to match the rounded facelift.  -->
                <!--  Active item: a 3px left accent bar (the VS Code cue) beside the raised pill, so
                      the current mode reads at a glance and by more than colour alone.  -->
                <Grid Margin="0,8,0,4">
                    <Border x:Name="ExploreAccentBar" Width="3" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center"
                            CornerRadius="0,2,2,0" Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                    <Button x:Name="ExploreRailButton" Click="OnToggleExplorer" Margin="6,0,6,0" Height="44" Style="{StaticResource RoundedButton}"
                            AutomationProperties.Name="Explore perspective" Background="Transparent"
                            BorderThickness="0" Foreground="{StaticResource TextMutedBrush}" ToolTip="Explore perspective">
                        <Path Width="22" Height="22" Stretch="Uniform" Data="{StaticResource IconExplore}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </Grid>
                <!--  AR3 — A RAIL ITEM IS PRESENT ONLY IF IT DOES SOMETHING. Three buttons used to
                      sit here, IsEnabled="False", announcing "Coordinate", "Compose" and "Audit" -
                      perspectives the Perspective set does not have. Disabling them removed the lie and kept the
                      dead UI: at rest they were the same 44x44 pill in the same muted foreground as
                      the one that works, so "none of these icons do anything" was a fair reading of
                      a rail where three of four did not.

                      They are DELETED rather than re-enabled because whether those modes get built
                      is a product decision and an absent row is the honest state of one that has not
                      been made. Explorer stays: it is the ONLY door to the Knowledge Explorer in the
                      product, and the instruction as written ("get rid of them") would have removed
                      it along with the placeholders.  -->
            </StackPanel>

            <!--  The docking host is injected by the composition root, not declared here: the
                  layout model is the source of truth and the view is its projection.  -->
            <ContentControl x:Name="WorkbenchHost"
                            Grid.Column="1"
                            AutomationProperties.Name="Workbench panes" />
        </Grid>

        <!--  Status strip. The live region lives here: announcements are both spoken to assistive
              technology and visible, so sighted and non-sighted users get the same information.  -->
        <Grid Grid.Row="3"
              Background="{StaticResource SurfaceSunkenBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="LiveRegionHost"
                            Grid.Column="0"
                            Margin="12,6" />
            <TextBlock Grid.Column="1"
                       Margin="12,6"
                       AutomationProperties.Name="Workspace health"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="{Binding StatusMessage}" />
        </Grid>
    </Grid>
    </Grid>
</Window>
