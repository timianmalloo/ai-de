<Window x:Class="AiDe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1180"
        Height="720"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
    <!--  RootLayer lets the command palette overlay the workbench without displacing it.  -->
    <Grid x:Name="RootLayer">
    <!--  Layout:MultiPanelWorkstation — the docking host owns the whole body. Nothing here is a
          fixed region: every pane is resizable, dockable, floatable and collapsible (US-9).  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Menu bar. Every item here also has a keyboard chord and a palette entry, and the chord
              is shown beside it — a command reachable only by a chord nobody was told about is a
              command nobody uses, which is what this row exists to fix.  -->
        <Menu Grid.Row="0" x:Name="MainMenu" />

        <!--  Title strip: workspace identity and the named-layout switcher.  -->
        <Grid Grid.Row="1"
              Background="{StaticResource SurfaceSunkenBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="12,8"
                       FontSize="15"
                       Foreground="{StaticResource TextBrush}"
                       Text="{Binding Heading}" />
            <Button Grid.Column="2"
                    Margin="12,6"
                    Padding="10,3"
                    Style="{StaticResource RoundedButton}"
                    AutomationProperties.Name="Reset workbench layout"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    Click="OnResetLayout"
                    Content="Reset layout"
                    Foreground="{StaticResource TextBrush}" />
        </Grid>

        <!--  Body: navigation rail plus the docking host.  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Background="{StaticResource SurfaceSunkenBrush}"
                        KeyboardNavigation.TabNavigation="Once">
                <Button Margin="6,8,6,2" Height="46" Style="{StaticResource RoundedButton}"
                        AutomationProperties.Name="Explore" Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource AccentBrush}" ToolTip="Explore">
                    <StackPanel>
                        <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconExplore}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock Text="Explore" FontSize="9" Margin="0,2,0,0" HorizontalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
                <Button Margin="6,2" Height="46" Style="{StaticResource RoundedButton}"
                        AutomationProperties.Name="Coordinate" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextMutedBrush}" ToolTip="Coordinate">
                    <StackPanel>
                        <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconCoordinate}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock Text="Coordinate" FontSize="9" Margin="0,2,0,0" HorizontalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
                <Button Margin="6,2" Height="46" Style="{StaticResource RoundedButton}"
                        AutomationProperties.Name="Compose" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextMutedBrush}" ToolTip="Compose">
                    <StackPanel>
                        <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconCompose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock Text="Compose" FontSize="9" Margin="0,2,0,0" HorizontalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
                <Button Margin="6,2" Height="46" Style="{StaticResource RoundedButton}"
                        AutomationProperties.Name="Audit" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextMutedBrush}" ToolTip="Audit">
                    <StackPanel>
                        <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconAudit}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock Text="Audit" FontSize="9" Margin="0,2,0,0" HorizontalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  The docking host is injected by the composition root, not declared here: the
                  layout model is the source of truth and the view is its projection.  -->
            <ContentControl x:Name="WorkbenchHost"
                            Grid.Column="1"
                            AutomationProperties.Name="Workbench panes" />
        </Grid>

        <!--  Status strip. The live region lives here: announcements are both spoken to assistive
              technology and visible, so sighted and non-sighted users get the same information.  -->
        <Grid Grid.Row="3"
              Background="{StaticResource SurfaceSunkenBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="LiveRegionHost"
                            Grid.Column="0"
                            Margin="12,6" />
            <TextBlock Grid.Column="1"
                       Margin="12,6"
                       AutomationProperties.Name="Workspace health"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="{Binding StatusMessage}" />
        </Grid>
    </Grid>
    </Grid>
</Window>
