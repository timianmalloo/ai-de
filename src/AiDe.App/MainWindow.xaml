<Window x:Class="AiDe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:AiDe.App.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1100"
        Height="700"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
    <!--  Master-detail per the B1 Keyboard-Velocity archetype: list left, provenance right,
          health strip along the bottom. Compact density, flat depth, dark-adaptive tokens.  -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="260" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="3"
                   Margin="0,0,0,12"
                   FontSize="18"
                   Foreground="{StaticResource TextBrush}"
                   Text="{Binding Heading}" />

        <!--  The accessible evidence list: the permanent keyboard/screen-reader surface,
              not a fallback for the Phase-2 canvas.  -->
        <ListBox x:Name="EvidenceList"
                 Grid.Row="1"
                 Grid.Column="0"
                 Background="{StaticResource SurfaceRaisedBrush}"
                 BorderBrush="{StaticResource BorderBrush}"
                 BorderThickness="1"
                 Foreground="{StaticResource TextBrush}"
                 ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                 AutomationProperties.Name="Evidence items"
                 KeyboardNavigation.TabNavigation="Once"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="MinHeight" Value="28" />
                    <!--  The row's accessible name carries label, kind AND confidence, so a screen
                          reader hears everything the visual row shows.  -->
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <!--  Confidence is glyph + text, never colour alone (WCAG 2.2 AA).  -->
                        <TextBlock MinWidth="16"
                                   FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{StaticResource AccentBrush}"
                                   Text="{Binding Confidence.Glyph}" />
                        <TextBlock Margin="6,0,0,0"
                                   Foreground="{StaticResource TextBrush}"
                                   Text="{Binding DisplayLabel}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DisplayLabel}" />
                        <TextBlock Margin="8,0,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Confidence.Text}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--  Provenance pane, in the fixed evidence order:
              what it is -> confidence/provenance -> related nodes -> source -> limits.  -->
        <Border Grid.Row="1"
                Grid.Column="2"
                Padding="16"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock AutomationProperties.Name="Provenance for the selected item"
                           Foreground="{StaticResource TextBrush}"
                           Text="{Binding ProvenanceText}"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <!--  Health strip: answers the 3 a.m. questions without opening a log.  -->
        <TextBlock Grid.Row="2"
                   Grid.ColumnSpan="3"
                   Margin="0,12,0,0"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="Workspace health"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="{Binding StatusMessage}" />
    </Grid>
</Window>
