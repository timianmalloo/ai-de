<Window x:Class="AiDe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wb="clr-namespace:AiDe.App.Workbench"
        mc:Ignorable="d"
        Title="AI-DE"
        Width="1180"
        Height="720"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
    <Window.Resources>
        <!--  PS-R4: every rail glyph is a registry entry, resolved by the row's title (Icon<Title>).
              IconExplore and IconAdd live in App.xaml's registry; these two are the rows Addendum C
              adds, kept beside the rail until they join that registry (seam request: App.xaml).  -->
        <Geometry x:Key="IconCoding">M8 8l-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14</Geometry>
        <Geometry x:Key="IconArchitecture">M4 20h16M6 20V9l6-4 6 4v11M10 20v-5h4v5M9.5 11h5</Geometry>

        <!--  The rail destination (DESIGN.md PS-R2 state table): rest - text-muted on the sunken
              rail; hover - text on surface-raised; selected - accent glyph on surface-raised with
              the 3px accent bar; focus - a 2px outer focus ring; error - a danger badge. The leaf
              never states its own ink: the container pairs, the glyph inherits (PS-T1's rule).
              No disabled state exists (AR3). 44 x 44 target (SC 2.5.8).  -->
        <Style TargetType="wb:PerspectiveRailItem">
            <!--  2px above and below: the outer focus ring's headroom, so the first destination's
                  ring is not clipped by the list's scroll presenter.  -->
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="wb:PerspectiveRailItem">
                        <Grid Background="Transparent">
                            <Border x:Name="AccentBar" Width="3" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    CornerRadius="0,2,2,0" Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            <!--  The focus ring is OUTER (DESIGN.md's rail rule): a sibling drawn 2px outside
                                  the pill, never inset into the 44 x 44 target or over the pill's ground.  -->
                            <Border x:Name="FocusRing" Margin="4,-2,4,-2" CornerRadius="12" BorderThickness="2"
                                    BorderBrush="{StaticResource FocusBrush}" Visibility="Collapsed" />
                            <Border x:Name="Pill" Margin="6,0,6,0" CornerRadius="10" Background="{TemplateBinding Background}">
                                <Grid>
                                    <Path Width="22" Height="22" Stretch="Uniform" Data="{TemplateBinding Glyph}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                          StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Ellipse x:Name="ErrorBadge" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Margin="0,4,4,0" Fill="{StaticResource DangerBrush}" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="HasFailure" Value="True">
                                <Setter TargetName="ErrorBadge" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--  RootLayer lets the command palette overlay the workbench without displacing it.  -->
    <Grid x:Name="RootLayer">
    <!--  Layout:MultiPanelWorkstation — the docking host owns the whole body. Nothing here is a
          fixed region: every pane is resizable, dockable, floatable and collapsible (US-9).  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Menu bar. Every item here also has a keyboard chord and a palette entry, and the chord
              is shown beside it — a command reachable only by a chord nobody was told about is a
              command nobody uses, which is what this row exists to fix.  -->
        <Menu Grid.Row="0" x:Name="MainMenu" />

        <!--  Title strip: workspace identity and the named-layout switcher.  -->
        <Grid Grid.Row="1"
              Background="{StaticResource SurfaceSunkenBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="12,8"
                       FontSize="15"
                       Foreground="{StaticResource TextBrush}"
                       Text="{Binding Heading}" />
            <Button Grid.Column="2"
                    Margin="12,6"
                    Padding="10,3"
                    Style="{StaticResource RoundedButton}"
                    AutomationProperties.Name="Reset workbench layout"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    Click="OnResetLayout"
                    Content="Reset layout"
                    Foreground="{StaticResource TextBrush}" />
        </Grid>

        <!--  Body: navigation rail plus the docking host.  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  No TabNavigation=Once on this container (the UX & Accessibility reviewer's blocker):
                  a Once group is ONE stop, so Tab from New session would leave the rail and never
                  enter the destinations. The destinations carry their own roving tab-stop.  -->
            <StackPanel x:Name="ActivityRail"
                        Grid.Column="0"
                        Background="{StaticResource SurfaceSunkenBrush}"
                        KeyboardNavigation.DirectionalNavigation="Cycle">
                <!--  AR2 — THE ONE PRIMARY ACTION, above the group and separated from it. The rail
                      holds DESTINATIONS (AR1); "new session" is a verb, so it does not join them,
                      and the accent fill is reserved for exactly this (DESIGN.md, icon system).
                      It runs the SAME catalog command as File -> New Session, so there is one door
                      and not a second one that can drift from it (AR5).  -->
                <Button x:Name="NewSessionRailButton" Click="OnNewSessionFromRail"
                        Margin="6,8,6,4" Height="44" Style="{StaticResource RoundedButton}"
                        AutomationProperties.Name="New session"
                        Background="{StaticResource AccentBrush}"
                        BorderThickness="0"
                        Foreground="{StaticResource SurfaceSunkenBrush}"
                        ToolTip="New session &#8212; Ctrl+N">
                    <Path Width="22" Height="22" Stretch="Uniform" Data="{StaticResource IconAdd}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Border Height="1" Margin="12,4,12,6" Background="{StaticResource BorderBrush}" />
                <!--  AR1 / PS-R2 - THE DESTINATIONS: Coding · Explore · Architecture, one selected,
                      manual activation (Up/Down move focus; Enter, Space or a click activate; Tab
                      leaves the rail once). A vertical tab list to UIA, its selected state the real
                      one - never a "(active)" name suffix. AR3: a destination that cannot be
                      entered is removed, never disabled; Tests is a reserved name with no row.  -->
                <wb:PerspectiveRail x:Name="Rail" Margin="0,4,0,0" />
            </StackPanel>

            <!--  The docking host is injected by the composition root, not declared here: the
                  layout model is the source of truth and the view is its projection.  -->
            <ContentControl x:Name="WorkbenchHost"
                            Grid.Column="1"
                            AutomationProperties.Name="Workbench panes" />
        </Grid>

        <!--  Status strip. The live region lives here: announcements are both spoken to assistive
              technology and visible, so sighted and non-sighted users get the same information.  -->
        <Grid Grid.Row="3"
              Background="{StaticResource SurfaceSunkenBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="LiveRegionHost"
                            Grid.Column="0"
                            Margin="12,6" />
            <TextBlock Grid.Column="1"
                       Margin="12,6"
                       AutomationProperties.Name="Workspace health"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="{Binding StatusMessage}" />
            <!--  The active perspective, named on the strip after every switch (spec §C6). No
                  AutomationProperties.Name: on a TextBlock it would REPLACE the text as the UIA
                  name, and AT would read the label instead of the perspective.  -->
            <TextBlock x:Name="PerspectiveStatus"
                       Grid.Column="2"
                       Margin="12,6"
                       Foreground="{StaticResource TextMutedBrush}" />
        </Grid>
    </Grid>
    </Grid>
</Window>
