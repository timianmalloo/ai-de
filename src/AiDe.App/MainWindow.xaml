<Window x:Class="AiDe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1180"
        Height="720"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
    <!--  RootLayer lets the command palette overlay the workbench without displacing it.  -->
    <Grid x:Name="RootLayer">
    <!--  Layout:MultiPanelWorkstation — the docking host owns the whole body. Nothing here is a
          fixed region: every pane is resizable, dockable, floatable and collapsible (US-9).  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Menu bar. Every item here also has a keyboard chord and a palette entry, and the chord
              is shown beside it — a command reachable only by a chord nobody was told about is a
              command nobody uses, which is what this row exists to fix.  -->
        <Menu Grid.Row="0" x:Name="MainMenu" />

        <!--  Title strip: workspace identity and the named-layout switcher.  -->
        <Grid Grid.Row="1"
              Background="{StaticResource SurfaceSunkenBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="12,8"
                       FontSize="15"
                       Foreground="{StaticResource TextBrush}"
                       Text="{Binding Heading}" />
            <Button Grid.Column="2"
                    Margin="12,6"
                    Padding="10,3"
                    Style="{StaticResource RoundedButton}"
                    AutomationProperties.Name="Reset workbench layout"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    Click="OnResetLayout"
                    Content="Reset layout"
                    Foreground="{StaticResource TextBrush}" />
        </Grid>

        <!--  Body: navigation rail plus the docking host.  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Background="{StaticResource SurfaceSunkenBrush}"
                        KeyboardNavigation.TabNavigation="Once"
                        KeyboardNavigation.DirectionalNavigation="Cycle">
                <!--  Roving tab-stop: Tab lands on the rail once; Up/Down arrows move between its
                      buttons (DirectionalNavigation=Cycle), the standard toolbar/activity-bar idiom.  -->
                <!--  Icon-only vertical navigation rail (VS Code / JetBrains idiom): the 56px column
                      cannot hold a legible text label under a 20px glyph, so labels were clipped
                      ("Coordinate" -> "ordina"). Discoverability is carried by the tooltip and the
                      accessibility by AutomationProperties.Name, so no meaning is lost by dropping the
                      caption. Targets are 44x44 (WCAG 2.5.8 comfortable). The active item is an accent
                      glyph on a soft raised pill with NO hard border, to match the rounded facelift.  -->
                <!--  Active item: a 3px left accent bar (the VS Code cue) beside the raised pill, so
                      the current mode reads at a glance and by more than colour alone.  -->
                <Grid Margin="0,8,0,4">
                    <Border x:Name="ExploreAccentBar" Width="3" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center"
                            CornerRadius="0,2,2,0" Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                    <Button x:Name="ExploreRailButton" Click="OnToggleExplorer" Margin="6,0,6,0" Height="44" Style="{StaticResource RoundedButton}"
                            AutomationProperties.Name="Explorer mode" Background="Transparent"
                            BorderThickness="0" Foreground="{StaticResource TextMutedBrush}" ToolTip="Explorer — graph &amp; reader">
                        <Path Width="22" Height="22" Stretch="Uniform" Data="{StaticResource IconExplore}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </Grid>
                <!-- IsEnabled=False, and it is the whole fix. ShellViewMode declares two modes; this
                     rail declared four, so three buttons were styled exactly like the working one,
                     carried a ToolTip promising a mode and an AutomationProperties.Name announcing
                     one, and did nothing at all on click - not even the "not available in this
                     build" the command layer says. Silence is the failure mode the disclosure work
                     exists to remove, and an inert control is a promise made in the UI.

                     Disabling is what makes it honest without deciding the product question: WPF
                     drops a disabled button from the tab order and reports it as disabled to
                     assistive technology, so nobody is told a button exists and left to discover by
                     pressing it that it is a no-op. Whether Coordinate is BUILT or REMOVED is the
                     user's call and is not made here. -->
                <Button Margin="6,4" Height="44" Style="{StaticResource RoundedButton}" IsEnabled="False"
                        AutomationProperties.Name="Coordinate" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextMutedBrush}" ToolTip="Coordinate — not in this build">
                    <Path Width="22" Height="22" Stretch="Uniform" Data="{StaticResource IconCoordinate}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <!-- IsEnabled=False, and it is the whole fix. ShellViewMode declares two modes; this
                     rail declared four, so three buttons were styled exactly like the working one,
                     carried a ToolTip promising a mode and an AutomationProperties.Name announcing
                     one, and did nothing at all on click - not even the "not available in this
                     build" the command layer says. Silence is the failure mode the disclosure work
                     exists to remove, and an inert control is a promise made in the UI.

                     Disabling is what makes it honest without deciding the product question: WPF
                     drops a disabled button from the tab order and reports it as disabled to
                     assistive technology, so nobody is told a button exists and left to discover by
                     pressing it that it is a no-op. Whether Compose is BUILT or REMOVED is the
                     user's call and is not made here. -->
                <Button Margin="6,4" Height="44" Style="{StaticResource RoundedButton}" IsEnabled="False"
                        AutomationProperties.Name="Compose" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextMutedBrush}" ToolTip="Compose — not in this build">
                    <Path Width="22" Height="22" Stretch="Uniform" Data="{StaticResource IconCompose}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <!-- IsEnabled=False, and it is the whole fix. ShellViewMode declares two modes; this
                     rail declared four, so three buttons were styled exactly like the working one,
                     carried a ToolTip promising a mode and an AutomationProperties.Name announcing
                     one, and did nothing at all on click - not even the "not available in this
                     build" the command layer says. Silence is the failure mode the disclosure work
                     exists to remove, and an inert control is a promise made in the UI.

                     Disabling is what makes it honest without deciding the product question: WPF
                     drops a disabled button from the tab order and reports it as disabled to
                     assistive technology, so nobody is told a button exists and left to discover by
                     pressing it that it is a no-op. Whether Audit is BUILT or REMOVED is the
                     user's call and is not made here. -->
                <Button Margin="6,4" Height="44" Style="{StaticResource RoundedButton}" IsEnabled="False"
                        AutomationProperties.Name="Audit" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextMutedBrush}" ToolTip="Audit — not in this build">
                    <Path Width="22" Height="22" Stretch="Uniform" Data="{StaticResource IconAudit}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>

            <!--  The docking host is injected by the composition root, not declared here: the
                  layout model is the source of truth and the view is its projection.  -->
            <ContentControl x:Name="WorkbenchHost"
                            Grid.Column="1"
                            AutomationProperties.Name="Workbench panes" />
        </Grid>

        <!--  Status strip. The live region lives here: announcements are both spoken to assistive
              technology and visible, so sighted and non-sighted users get the same information.  -->
        <Grid Grid.Row="3"
              Background="{StaticResource SurfaceSunkenBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="LiveRegionHost"
                            Grid.Column="0"
                            Margin="12,6" />
            <TextBlock Grid.Column="1"
                       Margin="12,6"
                       AutomationProperties.Name="Workspace health"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="{Binding StatusMessage}" />
        </Grid>
    </Grid>
    </Grid>
</Window>
